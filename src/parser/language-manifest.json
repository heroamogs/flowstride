{
  "schemaVersion": 1,
  "passwordToggle": true,
  "scopedBrowser": true,
  "conditions": ["masked", "revealed", "visible", "hidden", "attached", "enabled", "disabled", "editable", "checked", "empty", "focused", "text", "containsText", "value", "values", "count", "attribute", "css", "id", "property", "accessibleName", "accessibleDescription", "inViewport", "url", "title", "localStorage", "sessionStorage"],
  "assertions": ["assert.that", "assert.value", "dialog.expect", "network.expect", "download.expect", "stub.expect", "a11y.scan", "a11y.match", "api.expectSchema", "console.expect", "channel.expect", "visual.match"],
  "commands": {
    "a11y.match": {"selector": "body", "yaml": "- heading \"Ready\" [level=1]"},
    "a11y.scan": {"name": "checkout", "maxViolations": 0},
    "a11y.snapshot": {"name": "checkout", "selector": "body"},
    "api.close": {"name": "administrator"},
    "api.create": {"name": "administrator", "baseUrl": "{{env.API_URL}}", "cookies": true},
    "api.expectSchema": {"file": "fixtures/order.schema.json"},
    "api.poll": {"url": "/api/jobs/@jobId", "path": "status", "equals": "completed", "interval": 500, "timeout": 15000},
    "api.request": {"method": "POST", "url": "/api/documents", "multipart": {"description": "Test document", "file": {"path": "fixtures/document.pdf", "contentType": "application/pdf"}}, "timeout": 15000},
    "api.use": {"name": "administrator"},
    "assert.that": {"target": {"text": "Submit", "element": "button", "inside": "Checkout"}, "condition": "enabled"},
    "assert.value": {"actual": "@quantity", "operator": "equals", "expected": 2, "message": "The order has two items"},
    "browser.clearPermissions": {},
    "browser.close": {"name": "customer"},
    "browser.create": {"name": "customer"},
    "browser.geolocation": {"latitude": 6.5244, "longitude": 3.3792},
    "browser.list": {},
    "browser.offline": {"value": true},
    "browser.permissions": {"permissions": ["microphone"]},
    "browser.use": {"name": "customer"},
    "channel.arm": {"name": "order-updates", "protocol": "websocket", "url": "**/orders/socket"},
    "channel.expect": {"name": "order-updates", "path": "event", "equals": "order.updated"},
    "cleanup.register": {"method": "DELETE", "url": "/api/orders/@orderId"},
    "clock.fastForward": {"milliseconds": 1000},
    "clock.install": {"time": "2026-01-01T00:00:00Z"},
    "clock.pauseAt": {"time": "2026-01-01T00:00:01Z"},
    "clock.resume": {},
    "clock.runFor": {"milliseconds": 1000},
    "clock.setFixedTime": {"time": "2026-01-01T00:00:00Z"},
    "clock.setSystemTime": {"time": "2026-01-01T00:00:00Z"},
    "component.mount": {"module": "components/button.ts", "framework": "vanilla"},
    "component.unmount": {},
    "component.update": {"props": {"label": "Continue"}},
    "console.arm": {"name": "save-message", "level": "info", "contains": "Customer saved"},
    "console.expect": {"name": "save-message", "timeout": 5000},
    "data.cases": {"file": "fixtures/customers.json"},
    "data.load": {"file": "fixtures/customer.json", "as": "customer"},
    "data.seed": "customer-signup-regression",
    "dialog.arm": {"name": "rename-order", "action": "accept", "promptText": "Office supplies", "timeout": 5000},
    "dialog.expect": {"name": "rename-order", "type": "prompt", "message": "Enter order name"},
    "download.arm": {"name": "receipt"},
    "download.expect": {"name": "receipt", "minSize": 1},
    "download.save": {"name": "receipt", "file": "downloads/receipt.txt"},
    "file.read": {"file": "fixtures/customers.csv", "format": "csv", "as": "customers"},
    "files.select": {"target": {"text": "Attach documents", "element": "input"}, "files": ["fixtures/invoice.txt", "fixtures/receipt.txt"]},
    "frame.main": {},
    "frame.use": {"target": {"text": "Delivery details", "element": "iframe"}},
    "har.replay": {"file": "fixtures/catalog.har", "notFound": "abort"},
    "input.type": {"target": {"text": "Search", "element": "input", "inside": "Customer search"}, "text": " to Abuja", "clear": false, "delay": 25, "blur": false},
    "network.arm": {"name": "catalogResponse", "url": "**/api/catalog"},
    "network.expect": {"name": "catalogResponse", "status": 200},
    "network.route": {"name": "catalog", "url": "**/api/catalog", "json": {"items": []}},
    "network.unroute": {"name": "catalog"},
    "network.wait": {"name": "catalogResponse"},
    "stub.expect": {"name": "greeting", "count": 1},
    "stub.install": {"name": "greeting", "target": "window.alert", "mode": "spy"},
    "stub.restore": {"name": "greeting"},
    "tab.arm": {"name": "receipt", "timeout": 5000},
    "tab.close": {"name": "receipt"},
    "tab.name": {"name": "main"},
    "tab.use": {"name": "receipt"},
    "trace.start": {"name": "checkout"},
    "trace.stop": {},
    "visual.capture": {"name": "order-summary", "target": {"text": "Order summary", "inside": "Checkout"}},
    "visual.match": {"target": {"text": "Order summary", "inside": "Checkout"}, "baseline": "baselines/order-summary.png", "maxDiffRatio": 0.01}
  }
}
